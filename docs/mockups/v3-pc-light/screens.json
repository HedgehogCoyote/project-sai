[{"id": 1, "title": "로그인", "desc": "내 공간으로 들어가는 첫 화면", "body": "<div class=\"authbrand\"><span class=\"word\">SAI<span>●</span></span><h1>함께하는 일들을,<br>한 공간에.</h1><p>나의 기록부터 친구들과의 여행까지.</p></div><div class=\"authform\"><h2>다시 만나 반가워요</h2><label class=\"field\">아이디 <b class=\"mark\">1</b><input value=\"sai_user\" type=\"text\"></label><label class=\"field\">비밀번호 <b class=\"mark\">2</b><input value=\"example123!\" type=\"password\"></label><div class=\"buttons\"><a class=\"button primary\" href=\"?screen=03\">로그인<b class=\"mark\">3</b></a><a class=\"button \" href=\"?screen=02\">회원가입<b class=\"mark\">4</b></a></div></div>", "section": "공간 홈", "context": "친구 모임", "mode": "auth", "actions": [{"n": 1, "label": "아이디", "behavior": "아이디를 입력합니다. 빈 값이면 로그인할 수 없습니다.", "to": null}, {"n": 2, "label": "비밀번호", "behavior": "비밀번호를 입력합니다. 실제 로그인은 기존 인증 API에 연결합니다.", "to": null}, {"n": 3, "label": "로그인", "behavior": "입력을 확인하고 로그인 성공 시 내 공간으로 이동합니다. 실패하면 같은 화면에 오류를 표시합니다.", "to": 3}, {"n": 4, "label": "회원가입", "behavior": "회원가입 화면으로 이동합니다.", "to": 2}], "states": "실패: “아이디 또는 비밀번호를 확인해 주세요.” 제출 중 버튼 중복 클릭 방지. 소셜 로그인·비밀번호 재설정은 이번 범위에서 제외."}, {"id": 2, "title": "회원가입", "desc": "필요한 정보를 입력하고 계정 만들기", "body": "<div class=\"authbrand\"><span class=\"word\">SAI<span>●</span></span><h1>나만의 공간을<br>시작하세요.</h1><p>이미 계정이 있다면 로그인하세요.</p></div><div class=\"authform\"><h2>회원가입</h2><div class=\"grid\"><label class=\"field\">이름 <b class=\"mark\">1</b><input value=\"지민\" type=\"text\"></label><label class=\"field\">아이디 <b class=\"mark\">2</b><input value=\"sai_user\" type=\"text\"></label></div><div class=\"grid\"><label class=\"field\">비밀번호 <b class=\"mark\">3</b><input value=\"example123!\" type=\"password\"></label><label class=\"field\">비밀번호 확인 <b class=\"mark\">4</b><input value=\"example123!\" type=\"password\"></label></div><label class=\"field\">이메일 <b class=\"mark\">5</b><input value=\"jimin@example.test\" type=\"text\"></label><label class=\"field\">전화번호 <b class=\"mark\">6</b><input value=\"010-0000-0000\" type=\"text\"></label><div class=\"buttons\"><a class=\"button primary\" href=\"?screen=01\">가입하기<b class=\"mark\">7</b></a><a class=\"button \" href=\"?screen=01\">로그인으로<b class=\"mark\">8</b></a></div></div>", "section": "공간 홈", "context": "친구 모임", "mode": "auth", "actions": [{"n": 1, "label": "이름", "behavior": "이름을 입력합니다.", "to": null}, {"n": 2, "label": "아이디", "behavior": "가입 시 서버에서 중복을 검사합니다.", "to": null}, {"n": 3, "label": "비밀번호", "behavior": "서버 비밀번호 정책을 충족해야 합니다.", "to": null}, {"n": 4, "label": "비밀번호 확인", "behavior": "두 비밀번호가 일치해야 합니다.", "to": null}, {"n": 5, "label": "이메일", "behavior": "이메일 형식을 검사합니다. 샘플 주소입니다.", "to": null}, {"n": 6, "label": "전화번호", "behavior": "기존 가입 API의 입력 항목입니다. 샘플 번호입니다.", "to": null}, {"n": 7, "label": "가입하기", "behavior": "필수 항목 확인 후 가입하고 로그인 화면으로 이동합니다. 중복 아이디 오류는 입력란 아래에 표시합니다.", "to": 1}, {"n": 8, "label": "로그인으로", "behavior": "입력을 취소하고 로그인으로 돌아갑니다.", "to": 1}], "states": "가입 요건은 기존 API와 대조해 확정합니다. 약관·인증·비밀번호 정책을 이미 구현됐다고 가정하지 않습니다."}, {"id": 3, "title": "내 공간", "desc": "개인 공간과 함께 사용하는 공간을 한눈에", "body": "<div class=\"buttons\"><a class=\"button primary\" href=\"?screen=04\">공간 만들기<b class=\"mark\">1</b></a><a class=\"button \" href=\"?screen=08\">받은 초대 2<b class=\"mark\">2</b></a></div><div class=\"grid\"><section class=\"card\"><h3>나의 공간</h3><span class=\"badge\">나 혼자</span><p>일상 메모와 해야 할 일</p><a class=\"button \" href=\"?screen=05\">공간 열기<b class=\"mark\">3</b></a></section><section class=\"card\"><h3>친구 모임</h3><span class=\"badge\">4명 함께</span><p>평소 이야기와 함께하는 활동</p><a class=\"button \" href=\"?screen=06\">공간 열기<b class=\"mark\">4</b></a></section><section class=\"card\"><h3>스터디</h3><span class=\"badge\">3명 함께</span><p>공부 계획을 함께 이어가는 공간</p><a class=\"button \" href=\"?screen=06\">공간 열기<b class=\"mark\">5</b></a></section></div>", "section": "내 공간", "context": "내 공간", "mode": "global", "actions": [{"n": 1, "label": "공간 만들기", "behavior": "새 공간을 만드는 창을 엽니다.", "to": 4}, {"n": 2, "label": "받은 초대 2", "behavior": "받은 초대를 확인합니다.", "to": 8}, {"n": 3, "label": "공간 열기", "behavior": "개인 공간의 홈을 엽니다. 멤버 초대 영역은 개인 상태에 맞춰 표시합니다.", "to": 5}, {"n": 4, "label": "공간 열기", "behavior": "친구 모임 공간 홈으로 이동합니다.", "to": 6}, {"n": 5, "label": "공간 열기", "behavior": "선택한 스터디 공간의 홈으로 이동합니다. 같은 공간 홈 구조를 사용합니다.", "to": 6}], "states": "로딩 → 성공 또는 오류 안내. 오류가 나면 입력을 유지하고 다시 시도합니다."}, {"id": 4, "title": "공간 만들기", "desc": "계속 사용할 공간의 이름을 정하기", "body": "<div class=\"formbox\"><h2>어떤 공간을 만들까요?</h2><label class=\"field\">공간 이름 <b class=\"mark\">1</b><input value=\"친구 모임\" type=\"text\"></label><label class=\"field\">한 줄 소개 <b class=\"mark\">2</b><input value=\"함께 계획하고 기록하는 공간\" type=\"text\"></label><div class=\"hint\">혼자 시작해도 괜찮아요. 만든 뒤 친구를 초대할 수 있어요.</div><div class=\"buttons\"><a class=\"button primary\" href=\"?screen=05\">공간 만들기<b class=\"mark\">3</b></a><a class=\"button \" href=\"?screen=03\">취소<b class=\"mark\">4</b></a></div></div>", "section": "공간 홈", "context": "내 공간", "mode": "global", "actions": [{"n": 1, "label": "공간 이름", "behavior": "필수 입력입니다. 공백만 있으면 생성할 수 없습니다.", "to": null}, {"n": 2, "label": "한 줄 소개", "behavior": "선택 입력입니다. 공간 홈 제목 아래 표시합니다.", "to": null}, {"n": 3, "label": "공간 만들기", "behavior": "공간을 만들고 내가 관리자가 됩니다. 빈 공간 홈으로 이동합니다.", "to": 5}, {"n": 4, "label": "취소", "behavior": "아무것도 만들지 않고 내 공간으로 돌아갑니다.", "to": 3}], "states": "만드는 중 중복 제출을 막습니다. 실패해도 이름·소개 입력은 유지합니다."}, {"id": 5, "title": "처음 만든 공간", "desc": "빈 화면에서도 다음 행동을 바로 알기", "body": "<div class=\"empty\"><div class=\"emptyicon\">+</div><h2>이 공간을 어떻게 채울까요?</h2><p>기능을 하나 추가하거나, 함께할 사람을 초대해 보세요.</p><div class=\"buttons\"><a class=\"button primary\" href=\"?screen=10\">첫 기능 추가<b class=\"mark\">1</b></a><a class=\"button \" href=\"?screen=07\">사람 초대<b class=\"mark\">2</b></a></div></div><section class=\"card\"><h3>특정한 일을 함께한다면</h3><p>여행이나 모임처럼 하나의 활동으로 묶어 보세요.</p><a class=\"button \" href=\"?screen=18\">활동 만들기<b class=\"mark\">3</b></a></section>", "section": "공간 홈", "context": "친구 모임", "mode": "space", "actions": [{"n": 1, "label": "첫 기능 추가", "behavior": "기록·할 일·일정 등 필요한 기능을 고릅니다.", "to": 10}, {"n": 2, "label": "사람 초대", "behavior": "이 공간에 참여할 사람을 초대합니다.", "to": 7}, {"n": 3, "label": "활동 만들기", "behavior": "활동의 목적과 제목을 입력합니다.", "to": 18}], "states": "기록이나 숫자를 임의로 채우지 않습니다. 개인 공간도 같은 빈 상태를 사용합니다."}, {"id": 6, "title": "공간 홈", "desc": "평소 콘텐츠와 활동을 명확히 구분하기", "body": "<div class=\"buttons\"><a class=\"button \" href=\"?screen=07\">사람 초대<b class=\"mark\">1</b></a><a class=\"button primary\" href=\"?screen=18\">활동 만들기<b class=\"mark\">2</b></a></div><div class=\"grid\"><section class=\"card\"><h3>오늘 할 일</h3><div class=\"row\"><div><strong>모임 날짜 정하기</strong><p>친구 모임 · 오늘</p></div><div><span class=\"badge\">미완료</span></div></div><div class=\"row\"><div><strong>준비물 정리</strong><p>제주 여행 · 10월 15일</p></div><div><span class=\"badge\">활동</span></div></div><a class=\"button \" href=\"?screen=13\">할 일 전체 보기<b class=\"mark\">3</b></a></section><section class=\"card\"><h3>최근 기록</h3><div class=\"row\"><div><strong>다음 모임 이야기</strong><p>공간 기록 · 오늘 14:20</p></div><div></div></div><div class=\"row\"><div><strong>여행 준비 메모</strong><p>제주 여행 · 어제</p></div><div></div></div><a class=\"button \" href=\"?screen=11\">기록 전체 보기<b class=\"mark\">4</b></a></section></div><section class=\"card\"><h3>진행 중인 활동</h3><div class=\"row\"><div><strong>제주 여행</strong><p>2026.10.16–10.18 · 4명</p></div><div><a class=\"button primary\" href=\"?screen=20\">활동 열기<b class=\"mark\">5</b></a></div></div><div class=\"row\"><div><strong>연말 모임</strong><p>날짜 미정 · 준비 중</p></div><div><a class=\"button \" href=\"?screen=20\">상세 보기<b class=\"mark\">6</b></a></div></div></section><a class=\"button \" href=\"?screen=30\">보관한 활동 보기<b class=\"mark\">7</b></a>", "section": "공간 홈", "context": "친구 모임", "mode": "space", "actions": [{"n": 1, "label": "사람 초대", "behavior": "공간 초대 창을 엽니다.", "to": 7}, {"n": 2, "label": "활동 만들기", "behavior": "공간 안에 특정 활동을 만듭니다.", "to": 18}, {"n": 3, "label": "할 일 전체 보기", "behavior": "공간과 활동의 할 일을 소속 표시와 함께 확인합니다.", "to": 13}, {"n": 4, "label": "기록 전체 보기", "behavior": "공간 기록 목록으로 이동합니다.", "to": 11}, {"n": 5, "label": "활동 열기", "behavior": "제주 여행의 활동 홈을 엽니다.", "to": 20}, {"n": 6, "label": "상세 보기", "behavior": "선택한 활동의 홈을 엽니다. 날짜 미정도 허용합니다.", "to": 20}, {"n": 7, "label": "보관한 활동 보기", "behavior": "완료·보관한 활동을 확인합니다.", "to": 30}], "states": "로딩 → 성공 또는 오류 안내. 오류가 나면 입력을 유지하고 다시 시도합니다."}, {"id": 7, "title": "사람 초대", "desc": "누구를 어느 공간에 초대하는지 확인하기", "body": "<div class=\"formbox\"><h2>친구 모임에 초대하기</h2><p class=\"muted\">초대를 수락하면 이 공간의 기록과 활동을 볼 수 있어요.</p><label class=\"field\">초대할 아이디 <b class=\"mark\">1</b><input value=\"sai_friend\" type=\"text\"></label><a class=\"button \" href=\"?screen=07\">사용자 찾기<b class=\"mark\">2</b></a><div class=\"hint\">초대 대상: 하린 · @sai_friend · 이름을 확인하고 초대해 주세요.</div><div class=\"buttons\"><a class=\"button primary\" href=\"?screen=09\">초대 보내기<b class=\"mark\">3</b></a><a class=\"button \" href=\"?screen=06\">취소<b class=\"mark\">4</b></a></div></div><section class=\"card\"><h3>초대할 때 확인해 주세요</h3><p>이미 참여 중인 사람, 나 자신, 초대가 진행 중인 사람은 다시 초대할 수 없어요.</p></section>", "section": "공간 홈", "context": "친구 모임", "mode": "space", "actions": [{"n": 1, "label": "초대할 아이디", "behavior": "상대방의 로그인 아이디로 사용자를 찾는 제안입니다. 기존 숫자 ID 초대 API 앞에 사용자 조회 연결이 필요합니다.", "to": null}, {"n": 2, "label": "사용자 찾기", "behavior": "아이디에 해당하는 사용자의 이름을 확인합니다. 찾은 사람을 확인한 뒤 초대를 전송합니다.", "to": 7}, {"n": 3, "label": "초대 보내기", "behavior": "초대 요청을 보냅니다. 성공 메시지 후 멤버 화면의 초대 중 목록에 반영합니다.", "to": 9}, {"n": 4, "label": "취소", "behavior": "초대를 보내지 않고 공간 홈으로 돌아갑니다.", "to": 6}], "states": "대상을 찾을 수 없음 / 이미 초대함 / 권한 없음 / 전송 실패를 각각 안내합니다. 실제 초대 전송이 일어나는 목업은 아닙니다."}, {"id": 8, "title": "받은 초대", "desc": "수락과 거절의 결과를 바로 이해하기", "body": "<section class=\"card\"><h3>스터디에서 초대했어요</h3><div class=\"row\"><div><strong>스터디</strong><p>초대한 사람: 지민 · 3명 참여 중</p></div><div></div></div><div class=\"hint\">수락하면 이 공간의 멤버가 되고 기록과 활동을 볼 수 있어요.</div><div class=\"buttons\"><a class=\"button primary\" href=\"?screen=03\">수락<b class=\"mark\">1</b></a><a class=\"button \" href=\"?screen=08\">거절<b class=\"mark\">2</b></a></div></section><section class=\"card\"><h3>주말 독서 모임에서 초대했어요</h3><div class=\"row\"><div><strong>주말 독서 모임</strong><p>초대한 사람: 수연 · 2명 참여 중</p></div><div></div></div><div class=\"buttons\"><a class=\"button primary\" href=\"?screen=03\">수락<b class=\"mark\">3</b></a><a class=\"button \" href=\"?screen=08\">거절<b class=\"mark\">4</b></a></div></section>", "section": "받은 초대", "context": "받은 초대", "mode": "global", "actions": [{"n": 1, "label": "수락", "behavior": "초대를 수락하고 내 공간 목록에 스터디를 추가합니다.", "to": 3}, {"n": 2, "label": "거절", "behavior": "해당 초대를 거절합니다. 공간 멤버로 추가되지 않습니다.", "to": 8}, {"n": 3, "label": "수락", "behavior": "이 초대를 수락하고 해당 공간이 내 공간에 나타납니다.", "to": 3}, {"n": 4, "label": "거절", "behavior": "이 초대만 거절합니다.", "to": 8}], "states": "초대 없음 / 이미 처리됨 / 만료·취소됨 / 처리 실패. 같은 초대를 두 번 처리하지 않습니다."}, {"id": 9, "title": "함께하는 사람", "desc": "현재 멤버와 수락 대기 중인 초대를 구분하기", "body": "<div class=\"buttons\"><a class=\"button primary\" href=\"?screen=07\">사람 초대<b class=\"mark\">1</b></a></div><section class=\"card\"><h3>현재 멤버 4명</h3><table><thead><tr><th>이름</th><th>역할</th><th>상태</th></tr></thead><tbody><tr><td>지민 (나)</td><td><span class=\"badge\">소유자</span></td><td>참여 중</td></tr><tr><td>수연</td><td><span class=\"badge\">관리자</span></td><td>참여 중</td></tr><tr><td>민수</td><td>멤버</td><td>참여 중</td></tr><tr><td>도현</td><td>멤버</td><td>참여 중</td></tr></tbody></table></section><section class=\"card\"><h3>초대 중</h3><div class=\"row\"><div><strong>하린 · @sai_friend</strong><p>보낸 날짜: 10월 5일</p></div><div><span class=\"badge\">수락 대기</span></div></div></section>", "section": "멤버", "context": "친구 모임", "mode": "space", "actions": [{"n": 1, "label": "사람 초대", "behavior": "새 초대를 보냅니다.", "to": 7}], "states": "역할은 읽기 전용입니다. 역할 변경·강제 퇴장·소유권 이전은 이번 범위에서 제외합니다."}, {"id": 10, "title": "기능 추가", "desc": "어디에 추가할지 먼저 선택하기", "body": "<label class=\"field\">추가할 위치 <b class=\"mark\">1</b><select><option>친구 모임 · 공간 전체</option><option>제주 여행 · 특정 활동</option></select></label><div class=\"grid